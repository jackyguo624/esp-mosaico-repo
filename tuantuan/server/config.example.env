# Template only. Copy to config.env and fill in your own values locally.
# config.env is ignored by Git. Do not commit real tokens or API keys.
HOST=0.0.0.0
PORT=8765
# Generate a random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=replace-with-a-long-random-token
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
TIMEZONE=Asia/Shanghai
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# macOS say; Linux/Windows can use Piper with a Chinese voice model.
TTS_ENGINE=say
TTS_VOICE=Tingting
PIPER_BIN=piper
PIPER_MODEL=
# Explicit test mode: text demo responses, no actual ASR or LLM calls.
DEMO_MODE=0
