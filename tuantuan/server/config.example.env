# Template only. Copy to config.env and fill in your own values locally.
# config.env is ignored by Git. Do not commit real tokens or API keys.
HOST=0.0.0.0
PORT=8765
# Generate a random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=replace-with-a-long-random-token
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
TIMEZONE=Asia/Shanghai
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Download/load the model in the background before the first recording.
ASR_PRELOAD=1
ASR_CPU_THREADS=4
ASR_BEAM_SIZE=3
# Use regular HTTP when the model service's Xet route is unreliable.
ASR_DISABLE_XET=1
# macOS say; Linux/Windows can use Piper with a Chinese voice model.
TTS_ENGINE=say
TTS_VOICE=Tingting
TTS_RATE=180
# Memory-only cache; no speech files are retained.
TTS_CACHE_MB=8
PIPER_BIN=piper
PIPER_MODEL=
# Explicit test mode: text demo responses, no actual ASR or LLM calls.
DEMO_MODE=0

# 可选：仅供本机生成配网二维码；服务端不使用这两项。
WIFI_SSID=
WIFI_PASSWORD=
